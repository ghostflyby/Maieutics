{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Maieutics": {
    "Workspace": {
      "Root": null
    },
    "DefaultProfile": "gpt",
    "Sources": {
      "openai": {
        "Provider": "OpenAI",
        "ApiFlavor": "Responses",
        "ApiKey": "",
        "Endpoint": null
      },
      "anthropic": {
        "Provider": "Anthropic",
        "ApiKey": "",
        "Endpoint": null
      }
    },
    "Profiles": {
      "gpt": {
        "Source": "openai",
        "Model": "openai-model-id"
      },
      "claude": {
        "Source": "anthropic",
        "Model": "anthropic-model-id"
      }
    },
    "Agent": {
      "MaxRetainedTurns": 50,
      "MaxHistoryBytes": 400000,
      "MaxInputCharacters": 32000,
      "MaxResponseCharacters": 64000,
      "MaxModelIterationsPerTurn": 8,
      "MaxToolCallsPerTurn": 16,
      "MaxToolArgumentsBytes": 65536,
      "MaxToolResultBytes": 262144,
      "MaxToolProgressEventsPerCall": 256,
      "EventBufferCapacity": 128
    },
    "Jupyter": {
      "FlushInterval": "00:00:00.050",
      "FlushCharacters": 1024
    }
  }
}
