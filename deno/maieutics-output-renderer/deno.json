    "mathjax-full/js/input/tex/base/BaseConfiguration.js": "npm:mathjax-full@3.2.2/js/input/tex/base/BaseConfiguration.js",
    "mathjax-full/js/input/tex/ams/AmsConfiguration.js": "npm:mathjax-full@3.2.2/js/input/tex/ams/AmsConfiguration.js",
    "mathjax-full/js/input/tex/newcommand/NewcommandConfiguration.js": "npm:mathjax-full@3.2.2/js/input/tex/newcommand/NewcommandConfiguration.js",
