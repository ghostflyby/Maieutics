{
  "imports": {
    "vscode": "npm:@types/vscode@1.99.1"
  },
  "publish": false,
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "npm:@types/node@22.17.0"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run .",
    "build": "deno bundle --format cjs --external vscode --minify -o dist/extension.js extension.ts",
    "build:media": "deno bundle --minify -o media/widgetRenderer.js renderer/widgetEntry.ts",
    "watch": "deno bundle --format cjs --external vscode -o dist/extension.js extension.ts --watch",
    "package": "deno run -A --no-lock npm:@vscode/vsce@3.9.2 package --no-dependencies"
  }
}
