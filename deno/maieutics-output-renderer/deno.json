{
  "publish": false,
  "exclude": [
    "dist/",
    "bundle/"
  ],
  "imports": {
    "js-yaml": "npm:js-yaml@3.15.2",
    "acorn": "npm:acorn@8.18.0",
    "@mdit-vue/plugin-headers": "npm:@mdit-vue/plugin-headers@2.1.3",
    "@mdit-vue/shared": "npm:@mdit-vue/shared@2.1.3",
    "markdown-it": "npm:markdown-it@14.3.1",
    "markdown-it-anchor": "npm:markdown-it-anchor@9.2.0",
    "markdown-it-container": "npm:markdown-it-container@4.0.0",
    "@types/markdown-it": "npm:@types/markdown-it@14.1.2",
    "@types/markdown-it-container": "npm:@types/markdown-it-container@2.0.10",
    "shiki/core": "npm:shiki@2.5.0/core",
    "shiki/engine/javascript": "npm:shiki@2.5.0/engine/javascript",
    "@shikijs/transformers": "npm:@shikijs/transformers@2.5.0",
    "@shikijs/langs/typescript": "npm:@shikijs/langs@2.5.0/typescript",
    "@shikijs/langs/javascript": "npm:@shikijs/langs@2.5.0/javascript",
    "@shikijs/langs/json": "npm:@shikijs/langs@2.5.0/json",
    "@shikijs/themes/github-light": "npm:@shikijs/themes@2.5.0/github-light",
    "@shikijs/themes/github-dark": "npm:@shikijs/themes@2.5.0/github-dark",
    "vue": "npm:vue@3.5.13",
    "vue/server-renderer": "npm:vue@3.5.13/server-renderer",
    "@mdit-vue/plugin-toc": "npm:@mdit-vue/plugin-toc@2.1.3",
    "markdown-it-attrs": "npm:markdown-it-attrs@4.3.1",
    "@types/markdown-it-attrs": "npm:@types/markdown-it-attrs@4.1.3",
    "@vue/compiler-sfc": "npm:@vue/compiler-sfc@3.5.13/dist/compiler-sfc.esm-browser.js",
    "@mdit-vue/plugin-sfc": "npm:@mdit-vue/plugin-sfc@2.1.3",
    "@mdit-vue/plugin-component": "npm:@mdit-vue/plugin-component@2.1.3",
    "sucrase": "npm:sucrase@3.35.0",
    "@mdit-vue/plugin-frontmatter": "npm:@mdit-vue/plugin-frontmatter@2.1.3"
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test --allow-env=NODE_ENV,VSCODE_TEXTMATE_DEBUG --unstable-worker-options",
    "build": "deno bundle --platform=browser --config deno.worker.json --minify -o dist/vue_worker.js vue_worker.ts && deno run --allow-read=dist/vue_worker.js --allow-write=bundle/vue_worker_source.js build_vue_worker.ts && deno bundle --minify -o dist/smoke.js smoke.ts && deno bundle --minify -o bundle/service.js service_main.ts && deno run --allow-read=bundle/service.js,vendor/vitepress/LICENSE --allow-write=bundle/service.js bundle_output.ts",
    "smoke:offline": "deno run --unstable-worker-options --no-config --no-npm --no-remote --cached-only --deny-net --deny-run --deny-read --deny-write --allow-env=VSCODE_TEXTMATE_DEBUG dist/smoke.js"
  }
}
