{
  "workspace": [
    "./maieutics-repl-client",
    "./maieutics-deno-repl",
    "./maieutics-plugin-sdk",
    "./maieutics-plugin-host",
    "./maieutics-vscode"
  ],
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "imports": {
    "@ghostflyby/aves/repl": "jsr:@ghostflyby/aves@0.6.0/repl",
    "@ghostflyby/worker-actor": "jsr:@ghostflyby/worker-actor@0.6.0",
    "@preact/signals-core": "npm:@preact/signals-core@1.14.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "maieutics-widgets": "./maieutics-plugin-sdk/widgets/index.ts",
    "maieutics-widgets/jsx-runtime": "./maieutics-plugin-sdk/widgets/jsx-runtime.ts",
    "esbuild-wasm": "npm:esbuild-wasm@0.25.12"
  },
  "tasks": {
    "check": "deno check",
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-import --unstable-worker-options && node maieutics-node-runtime/node_worker_patch_test_runner.cjs"
  }
}
