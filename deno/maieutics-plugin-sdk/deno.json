{
  "name": "@maieutics/plugin-sdk",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./entry.ts",
    "./http": "./http.ts",
    "./runtime": "./runtime.ts",
    "./interop": "./interop.ts",
    "./reactive": "./reactive.ts",
    "./ui": "./ui/index.ts",
    "./lint": "./lint-plugin.ts",
    "./plugin-ui": "./plugin-ui.ts",
    "./actor": "./actor-runtime/mod.ts",
    "./actor/codec": "./actor-runtime/codec.ts",
    "./actor/codecs": "./actor-runtime/codecs.ts"
  },
  "imports": {
    "@vue/reactivity": "npm:@vue/reactivity@3.5.13/dist/reactivity.esm-browser.prod.js",
    "@maieutics/plugin-sdk/actor": "./actor-runtime/mod.ts",
    "@maieutics/plugin-sdk/actor/codec": "./actor-runtime/codec.ts",
    "@maieutics/plugin-sdk/actor/codecs": "./actor-runtime/codecs.ts",
    "@ghostflyby/worker-actor": "./actor-runtime/mod.ts",
    "@ghostflyby/worker-actor/codec": "./actor-runtime/codec.ts",
    "@ghostflyby/worker-actor/codecs": "./actor-runtime/codecs.ts"
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --unstable-worker-options",
    "test:actor": "deno test --allow-read --allow-run --allow-env --allow-net actor-runtime/"
  },
  "publish": {
    "exclude": [
      "actor-runtime/**/*_test.ts",
      "actor-runtime/test_fixtures/"
    ]
  }
}
