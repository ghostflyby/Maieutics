    "@shikijs/langs/markdown": "npm:@shikijs/langs@2.5.0/markdown",
    "@shikijs/langs/diff": "npm:@shikijs/langs@2.5.0/diff",
    "@shikijs/langs/dockerfile": "npm:@shikijs/langs@2.5.0/dockerfile",
    "@shikijs/langs/xml": "npm:@shikijs/langs@2.5.0/xml",
    "@shikijs/langs/powershell": "npm:@shikijs/langs@2.5.0/powershell",
    "@shikijs/langs/ruby": "npm:@shikijs/langs@2.5.0/ruby",
