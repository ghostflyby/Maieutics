{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Maieutics": {
    "Workspace": {
      "Root": null
    },
    "DefaultProfile": "gpt",
    "Sources": {
      "openai": {
        "Provider": "OpenAI",
        "ApiFlavor": "Responses",
        "ApiKey": "",
        "Endpoint": null
      },
      "anthropic": {
        "Provider": "Anthropic",
        "ApiKey": "",
        "Endpoint": null
      }
    },
    "Profiles": {
      "gpt": {
        "Source": "openai",
        "Model": "openai-model-id"
      },
      "claude": {
        "Source": "anthropic",
        "Model": "anthropic-model-id"
      }
    },
    "Endpoints": [],
    "Vendors": {},
    "Agent": {
      "MaxRetainedTurns": 50,
      "MaxHistoryBytes": 400000,
      "MaxInputCharacters": 32000,
      "MaxResponseCharacters": 64000,
      "MaxModelIterationsPerTurn": 24,
      "MaxTurnDuration": "00:00:00",
      "MaxToolCallsPerTurn": 48,
      "MaxToolArgumentsBytes": 65536,
      "MaxToolResultBytes": 262144,
      "MaxToolProgressEventsPerCall": 256,
      "EventBufferCapacity": 128
    },
    "DenoRepl": {
      "Executable": "deno",
      "MaxSessionsPerAgent": 4,
      "StartupTimeout": "00:00:30",
      "ExecutionTimeout": "00:02:00",
      "InterruptGracePeriod": "00:00:05",
      "ShutdownTimeout": "00:00:10",
      "MaxModelOutputBytes": 131072,
      "MaxPresentationTextBytes": 1048576,
      "MaxPresentationEventsPerExecution": 256,
      "MaxPresentationBundleBytes": 16777216
    },
    "Terminal": {
      "Shell": "/bin/sh",
      "Arguments": [],
      "MaxSessionsPerAgent": 4,
      "Columns": 120,
      "Rows": 30,
      "StartupTimeout": "00:00:15",
      "SettleTimeout": "00:00:00.600",
      "GracefulExitTimeout": "00:00:10",
      "MaxSnapshotCharacters": 16384
    },
    "Jupyter": {
      "FlushInterval": "00:00:00.050",
      "FlushCharacters": 1024
    }
  }
}
