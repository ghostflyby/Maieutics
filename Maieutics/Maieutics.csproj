<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AssemblyName>maieutics</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(RuntimeIdentifier)', '^(osx|linux)-'))">
        <!-- AsyncIO 0.1.69 contains a Windows-only dynamic delegate path that NativeAOT cannot prove unreachable. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3053</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Maieutics.Agent\Maieutics.Agent.csproj"/>
        <ProjectReference Include="..\Maieutics.Jupyter.Client\Maieutics.Jupyter.Client.csproj"/>
        <ProjectReference Include="..\Maieutics.Jupyter.Kernel\Maieutics.Jupyter.Kernel.csproj"/>
        <ProjectReference Include="..\Maieutics.Jupyter.Shared\Maieutics.Jupyter.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3"/>
        <PackageReference Include="ModelContextProtocol.Core" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\deno\maieutics-repl-client\mod.ts"
                          LogicalName="Maieutics.Deno.ReplClient.ts"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="kernelspec\kernel.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
