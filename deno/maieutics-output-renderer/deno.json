    "@shikijs/langs/cpp": "npm:@shikijs/langs@2.5.0/cpp",
    "@shikijs/langs/c": "npm:@shikijs/langs@2.5.0/c",
    "@shikijs/langs/java": "npm:@shikijs/langs@2.5.0/java",
    "@shikijs/langs/go": "npm:@shikijs/langs@2.5.0/go",
    "@shikijs/langs/rust": "npm:@shikijs/langs@2.5.0/rust",
    "@shikijs/langs/sql": "npm:@shikijs/langs@2.5.0/sql",
    "@shikijs/langs/yaml": "npm:@shikijs/langs@2.5.0/yaml",
    "@shikijs/langs/toml": "npm:@shikijs/langs@2.5.0/toml",
