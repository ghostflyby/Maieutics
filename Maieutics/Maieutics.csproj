<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AssemblyName>maieutics</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <!-- SQLite provider mode: 'System' P/Invokes the OS sqlite3 (true single-file AOT),
             'Bundled' ships e_sqlite3 as a side-by-side native file. Platform defaults:
             Windows = System (winsqlite3.dll ships with Windows). macOS and Linux default
             to Bundled: Apple compiles its system libsqlite3 without load extension
             (missing sqlite3_load_extension symbols break linking), and Linux
             distributions vary. Override with -p:SqliteProviderMode=Bundled|System. -->
        <SqliteProviderMode Condition="'$(SqliteProviderMode)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">System</SqliteProviderMode>
        <SqliteProviderMode Condition="'$(SqliteProviderMode)' == ''">Bundled</SqliteProviderMode>
        <DefineConstants Condition="'$(SqliteProviderMode)' == 'System' and $([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);SQLITE_PROVIDER_SQLITE3</DefineConstants>
        <DefineConstants Condition="'$(SqliteProviderMode)' == 'System' and $([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);SQLITE_PROVIDER_WINSQLITE3</DefineConstants>
        <DefineConstants Condition="'$(SqliteProviderMode)' == 'Bundled'">$(DefineConstants);SQLite_PROVIDER_BUNDLED</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Maieutics.Agent\Maieutics.Agent.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ghostflyby.Pty" Version="0.5.0" />
        <!-- Core variant: no default SQLite engine dependency. The engine comes from the
             SqliteProviderMode-selected SQLitePCLRaw provider below (see the mode notes at
             the top of this file). -->
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
        <!-- Direct reference overrides the vulnerable 2.1.11 transitive (GHSA-2m69-gcr7-jv3q). -->
        <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
        <PackageReference Include="SQLitePCLRaw.provider.sqlite3"
                          Version="3.0.5"
                          Condition="'$(SqliteProviderMode)' == 'System' and $([MSBuild]::IsOSPlatform('OSX'))" />
        <PackageReference Include="SQLitePCLRaw.provider.winsqlite3"
                          Version="3.0.5"
                          Condition="'$(SqliteProviderMode)' == 'System' and $([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"
                          Version="3.0.5"
                          Condition="'$(SqliteProviderMode)' == 'Bundled'" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
        <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
        <PackageReference Include="XTerm.NET" Version="2.0.1" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>


